# Copy this file to .env and adjust if needed:  cp .env.example .env

# Port the Express server listens on
PORT=3000

# Base URL of the NHTSA vPIC API (no API key is required for this API)
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# How long (in milliseconds) Axios waits for the API before giving up
API_TIMEOUT_MS=8000

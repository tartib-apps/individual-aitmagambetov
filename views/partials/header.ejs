<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="CarCheck - decode a VIN and explore car models with the NHTSA vehicle database.">
  <title><%= title %> | CarCheck</title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles/main.css">
</head>

<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="logo-mark">CC</span>
        <span>Car<strong>Check</strong></span>
      </a>
      <nav class="nav">
